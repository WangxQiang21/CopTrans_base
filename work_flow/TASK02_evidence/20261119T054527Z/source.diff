+                             sum(math.hypot(b[0] - a[0], b[1] - a[1])
+                                 for a, b in zip(points, points[1:])))
+        self.assertGreaterEqual(window["sigma_window"][0], 0.0)
+        self.assertLessEqual(window["sigma_window"][1], 1.0)
