+    def test_window_formula_and_sigma(self):
+        grid = _test_grid()
+        chain = _chain((_rectangle(-4.0, -4.0, 0.0, 4.0),
+                        _rectangle(-4.0, -4.0, 4.0, 0.0)), grid)
