+        self.assertEqual(diagnostics["chain_digest"],
+                         round_record["chain_digest"])
+        self.assertEqual(diagnostics["chain_digest"],
+                         display["chain_sha256"])
+        self.assertEqual(diagnostics["guide_source"],
+                         display["guide_source"])
+        self.assertEqual(diagnostics["guide_source"],
+                         assessment["selected_guide_source"])
