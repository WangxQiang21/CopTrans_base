+_BISECTOR_SUM_MIN_M = 1e-6
+_NEAR_REVERSE_COS = -0.999999
+_ENDPOINT_TANGENT_TOL_RAD = math.radians(20.0)
+_CURVATURE_JUMP_HINT_PER_M = 1.0
