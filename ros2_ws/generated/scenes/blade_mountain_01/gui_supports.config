<?xml version="1.0"?>
<window>
    <width>1260</width>
    <height>820</height>
  </window>
  <plugin filename="MinimalScene" name="3D View">
    <gz-gui>
      <property type="bool" key="showTitleBar">false</property>
      <property type="string" key="state">docked</property>
    </gz-gui>
    <engine>ogre2</engine>
    <scene>scene</scene>
    <ambient_light>0.4 0.4 0.4</ambient_light>
    <background_color>0.75 0.78 0.81</background_color>
    <camera_pose>121.8 39.7 1.35 0.0 0.22504958394103008 -3.1284355181170365</camera_pose>
    <horizontal_fov>131.78029288008932</horizontal_fov>
  </plugin>
  <plugin filename="GzSceneManager" name="Scene manager">
    <gz-gui>
      <property type="string" key="state">floating</property>
      <property type="bool" key="showTitleBar">false</property>
      <property type="double" key="width">5</property>
      <property type="double" key="height">5</property>
    </gz-gui>
  </plugin>
  <plugin filename="InteractiveViewControl" name="Orbit camera">
    <gz-gui>
      <property type="string" key="state">floating</property>
      <property type="bool" key="showTitleBar">false</property>
      <property type="double" key="width">5</property>
      <property type="double" key="height">5</property>
    </gz-gui>
  </plugin>
