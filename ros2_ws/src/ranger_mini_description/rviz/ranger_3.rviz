Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 18
  - Class: rviz_default_plugins/RobotModel
    Name: Ranger Mini 1
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot1/robot_description
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 5
    TF Prefix: robot1
    Visual Enabled: true
    Collision Enabled: false
  - Class: rviz_default_plugins/RobotModel
    Name: Ranger Mini 2
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot2/robot_description
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 5
    TF Prefix: robot2
    Visual Enabled: true
    Collision Enabled: false
  - Class: rviz_default_plugins/RobotModel
    Name: Ranger Mini 3
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot3/robot_description
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 5
    TF Prefix: robot3
    Visual Enabled: true
    Collision Enabled: false
  Global Options:
    Background Color: 48; 49; 51
    Fixed Frame: world
    Frame Rate: 30
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6.15
      Focal Point:
        X: 0.7
        Y: 1.3
        Z: 0.15
      Pitch: 0.52
      Yaw: 0.9
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1120
  Height: 740
