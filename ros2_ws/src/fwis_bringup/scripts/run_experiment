#!/usr/bin/env python3
"""Start a measured experiment and coordinate the three existing trackers."""

from array import array
from bisect import bisect_right
from dataclasses import replace
from functools import partial
from hashlib import sha256
from itertools import combinations
import json
from math import cos, degrees, dist, hypot, isfinite, sin
import os
from pathlib import Path
from time import monotonic

from builtin_interfaces.msg import Time
from fwis_v3_msgs.msg import (FormationExecutionPermit, FormationPlanRequest, FormationPlaybackPlan,
                             FormationVehicleSpec, TimedPoint, TimedTrajectory)
from geometry_msgs.msg import Point, Pose2D, PoseStamped, PoseWithCovarianceStamped, Twist
from nav_msgs.msg import OccupancyGrid, Odometry
import rclpy
from rclpy.clock import Clock, ClockType
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, QoSProfile
from rclpy.serialization import serialize_message
from rclpy.signals import SignalHandlerOptions
from std_msgs.msg import Float64, Int32, String
from visualization_msgs.msg import MarkerArray
import yaml

from fwis_bringup.experiment_log import collect
from fwis_bringup.cts_cases import cargo_reference
from fwis_bringup.experiment_telemetry import ControllerLog, TREND_S
from fwis_bringup.formation_route import PERMIT_TOPIC, fit_reference, make_routes, pose_matches, pose_tuple
from fwis_bringup.interactive_formation import FormationPlacement, endpoint_markers
from fwis_bringup.run_metrics import RunMetrics
from fwis_bringup.test_config import read_config
from fwis_backends.multi_4wis.formation_playback import PLAYBACK_PLAN_BACKEND
from fwis_control.config import load
from fwis_control.model import Mode, Pose, between, wrap
from fwis_control.ros_state import planar_pose, stamp_ns
from ranger_mini_gz.scene_generator import installed_paths, load_scene, read_map
from ranger_mini_gz.scene_geometry import local_pose


DURABLE = QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL)
NSEC = 10**9


def string_topics(multi):
    return ("/formation/optimizer_status",) if multi else ("/plan/search_status", "/plan/status")


def pose2d(values):
    return Pose2D(x=float(values[0]), y=float(values[1]), theta=float(values[2]))


class RunExperiment(Node):
    def __init__(self):
        super().__init__("coptrans_test_run")
        path = Path(self.declare_parameter("run_config", "").value)
        self.directory = path.parent
        archive = os.environ.get("COPTRANS_ARCHIVE_DIR")
        self.archive = Path(archive) if archive else None
        self.experiment_id = self.directory.name
        self.config = read_config(path)
        self.interactive = self.config.get("interactive", False)
        self.assembly = None
        self.assembly_attached = False
        self.assembly_elapsed_s = None
        self.docked = 0
        self.transport_plan_id = 1
        self.terminal_alignment = "not_requested"
        self.alignment_start_s = None
        self.in_terminal_alignment = False
        self.max_spacing_error = 0.
        self.max_cargo_speed = 0.
        self.ui_enabled = self.interactive or self.config.get("assembly", False)
        paths = installed_paths()
        self.task = self.config["scene_task"]
        self.multi = self.task == "formation"
        self.formation_backend = self.config["coordination"]["implementation"] if self.multi else None
        self.native = self.config["planner_backend"] in ("single_hybrid_joint_cpp", "formation_hybrid_joint_cpp")
        self.native_release = None
        self.native_ready = None
        self.native_cancel = None
        if self.native:
            from fwis_bringup.native_readiness import NativeReadiness
            self.native_ready = NativeReadiness()
            for role, topic in (("planner","planner_readiness"),("executor","readiness")):
                self.create_subscription(String, "/hybrid_joint/"+topic,
                    lambda m,role=role:self.native_ready.observe(role,m.data,monotonic()), DURABLE)
            self.create_subscription(String, "/hybrid_joint/admission", self.on_native_admission, DURABLE)
            self.native_cancel = self.create_publisher(String, "/hybrid_joint/cancel", 1)
        self.execution_without_playback = bool(
            self.multi and self.config["planner_overrides"].get("execution_without_playback"))
        scene = load_scene(self.config["scenario"], self.config.get("scene_variant", "default"), paths=paths)
        experiment = {key: tuple(self.config[key]) for key in ("start", "goal", "waypoints")}
        self.scene = replace(scene, experiments={**scene.experiments, self.task: experiment})
        self.spawns = self.scene.spawn_poses(self.task)
        if self.config.get("assembly"):
            self.spawns = dict(zip(scene.vehicle_ids, scene.assembly_starts, strict=True))
        self.contract = read_config(paths[2] / "config" / "multi_4wis" / "transport_formation.yaml")
        self.timing = load(self.declare_parameter("controller_config", "").value).timing
        map_metadata, cells = read_map(self.directory / "scene" / "map.yaml")
        self.replay_mismatch = next((name for name, key in (("map.pgm", "replay_map_sha256"),
                                    ("map.pgm", "required_map_sha256"), ("scene_meta.yaml", "replay_scene_sha256"))
                                    if self.config.get(key) and sha256(
                                        (self.directory / "scene" / name).read_bytes()).hexdigest()
                                    != self.config[key]), None)
        if self.config.get("retest_map_metadata") and self.config["retest_map_metadata"] != map_metadata:
            self.replay_mismatch = "map.yaml"
        self.map_shape = cells.shape
        self.map_bytes = array("b", cells.tobytes())
        self.map_matches = False

        self.boot_wall = monotonic()
        self.measure_wall = self.boot_wall
        self.previous_measurement = None
        self.previous_cargo_pose = None
        self.last_ground_truth_step = {}
        self.odom, self.truth, self.modes, self.commands, self.controller_age = {}, {}, {}, {}, {}
        self.command_received_wall = {}
        self.decision_observation = self.final_observation = self.observation_due_wall = None
        self.initial = self.plan_keys = self.arm_stamp = self.request = None
        self.formation_plan = self.formation_routes = None
        self.cargo_plan_times = ()
        self.job = {}
        self.goals, self.planner_status, self.controller_status = {}, {}, {}
        self.planner_source = None
        self.plan_started = self.plan_wall = self.duration = self.end_wall = None
        self.admitted, self.complete, self.moved = set(), set(), set()
        self.phase = "waiting_for_simulation"
        self.result = None
        self.trace_events = []
        self.traced_twist = set()
        self.metrics = RunMetrics(self.directory, self.scene, self.task,
                                  motion_log_period=TREND_S if self.archive else 0.)
        if self.config.get("assembly"):
            from fwis_bringup.assembly_execution import AssemblyExecution
            self.assembly = AssemblyExecution(self, (map_metadata, cells))
        self.planner_log = (self.directory / "planner.log").open("w", buffering=1)
        self.controller_log = ControllerLog(self.directory, compact=self.archive is not None)

        self.create_subscription(OccupancyGrid, "/map", self.on_map, DURABLE)
        for index in self.spawns:
            prefix = f"/robot{index}"
            self.create_subscription(Odometry, f"{prefix}/odom", partial(self.on_odom, index), 5)
            self.create_subscription(PoseStamped, f"{prefix}/ground_truth_pose",
                                     partial(self.on_truth, index), 5)
            self.create_subscription(Int32, f"{prefix}/motion_state", partial(self.on_mode, index), 5)
            self.create_subscription(Twist, f"{prefix}/cmd_vel", partial(self.on_command, index), 5)
            self.create_subscription(String, f"{prefix}/controller_status",
                                     partial(self.on_controller, index), 30)
        for topic in string_topics(self.multi):
            self.create_subscription(String, topic, partial(self.on_planner, topic), DURABLE)
        if self.multi:
            self.start_pub = (None if self.native or self.formation_backend == PLAYBACK_PLAN_BACKEND else
                              self.create_publisher(PoseWithCovarianceStamped, "/initialpose", 10))
            self.goal_pub = self.create_publisher(FormationPlanRequest, "/formation/plan_request", 10)
            self.create_subscription(FormationPlaybackPlan, "/formation/playback_plan",
                                     self.on_formation, DURABLE)
            self.create_subscription(String, "/formation/job_state", self.on_job, DURABLE)
            self.routes = {} if self.native else {i: self.create_publisher(TimedTrajectory, f"/robot{i}/trajectory", DURABLE)
                           for i in self.spawns}
            self.permit_pub = None if self.native else self.create_publisher(FormationExecutionPermit, PERMIT_TOPIC, 1)
            self.cargo_pub = self.create_publisher(Odometry, "/cargo/odom", 5)
            self.mount_pub = self.create_publisher(Float64, "/cargo/constraint_error", 5)
            self.spacing_pub = self.create_publisher(Float64, "/formation/spacing_error", 5)
            self.cargo_status_pub = self.create_publisher(String, "/cargo/controller_status", 30)
        else:
            self.start_pub = self.create_publisher(PoseStamped, "/start_pose", 10)
            self.goal_pub = self.create_publisher(PoseStamped, "/move_base_simple/goal", 10)
            if self.native:
                self.create_subscription(FormationPlaybackPlan, "/hybrid_joint/plan", self.on_native_single, DURABLE)
            else:
                self.create_subscription(TimedTrajectory, "/plan/timed_trajectory", self.on_single, DURABLE)
        if self.ui_enabled:
            margin = self.config.get("replay_planner", self.config["planner_overrides"]).get("collision_margin", .05)
            self.placement = FormationPlacement(self.scene, cells, margin)
            self.pending_start = self.pending_goal = self.selected_start = self.placing = None
            self.last_selected_start = self.last_selected_goal = None
            self.placement_still_since = None
            self.execution_started_wall = None
            self.solver_outcome, self.solver_elapsed_s = "idle", None
            self.operator_log = (self.directory / "operator_events.jsonl").open("w", buffering=1)
            self.progress_log = (self.directory / "planning_progress.jsonl").open("w", buffering=1)
            self.ui_pub = self.create_publisher(String, "/formation/interactive_status", DURABLE)
            self.endpoints_pub = self.create_publisher(MarkerArray, "/formation/interactive_endpoints", DURABLE)
            if self.interactive:
                self.create_subscription(PoseWithCovarianceStamped, "/initialpose", self.select_start, 5)
                self.create_subscription(PoseStamped, "/move_base_simple/goal", self.select_goal, 5)
            progress_qos = QoSProfile(depth=10, durability=DurabilityPolicy.TRANSIENT_LOCAL)
            self.create_subscription(String, "/formation/uniform_progress", self.on_progress, progress_qos)
            self.ui("loading", detail="正在等待 Gazebo、地图和规划器")
        self.create_timer(.04, self.tick, clock=Clock(clock_type=ClockType.STEADY_TIME))

    def ui(self, phase, *, reason="", detail=""):
        if not self.ui_enabled or not rclpy.ok():
            return
        assembly = self.assembly and not self.assembly_attached
        admitted, complete = (self.assembly.admitted, self.assembly.complete) if assembly else (self.admitted, self.complete)
        document = {"phase": phase, "reason": reason, "detail": detail, "experiment_id": self.experiment_id,
                    "plan_id": self.request.plan_id if self.request else 0,
                    "solver_outcome": self.solver_outcome, "solver_elapsed_s": self.solver_elapsed_s,
                    "admitted": len(admitted), "complete": len(complete),
                    "vehicle_count": len(self.spawns), "docked": self.docked,
                    "assembly_elapsed_s": self.assembly_elapsed_s, "transport_elapsed_s": self.solver_elapsed_s,
                    "terminal_alignment": self.terminal_alignment}
        self.ui_pub.publish(String(data=json.dumps(document, ensure_ascii=False, allow_nan=False)))
        self.log_operator("panel_status", phase=phase, reason=reason, detail=detail)

    def log_operator(self, event, **fields):
        self.operator_log.write(json.dumps(dict(event=event, stamp_s=self.now(), **fields),
                                           ensure_ascii=False, allow_nan=False) + "\n")

    def on_progress(self, message):
        self.progress_log.write(message.data + "\n")

    def show_endpoints(self):
        start = self.pending_start or self.selected_start or (self.placing[0] if self.placing else None)
        goal = self.pending_goal
        if self.assembly:
            start, goal = (local_pose(value, self.scene.cargo.offset) if value else None for value in (start, goal))
        self.endpoints_pub.publish(endpoint_markers(start, goal, self.get_clock().now().to_msg()))

    def selection_open(self):
        return self.result is None and self.execution_started_wall is None

    def select_start(self, message):
        if not self.selection_open():
            return
        pose = planar_pose(message.pose.pose)
        self.last_selected_start = pose_tuple(pose) if pose is not None and message.header.frame_id == "map" else None
        self.last_selected_goal = None
        self.log_operator("select_start", frame=message.header.frame_id, pose=self.last_selected_start)
        if message.header.frame_id != "map" or pose is None:
            self.ui("waiting_start", reason="起点无效", detail="请选择 map 坐标系中的有限位姿")
            return
        target = pose_tuple(pose)
        if self.assembly:
            target = cargo_reference(target, self.scene.cargo.offset)
        self.pending_start = self.selected_start = self.pending_goal = None
        obstacle = self.placement.obstruction(target)
        if obstacle:
            self.placing = None
            self.show_endpoints()
            self.ui("waiting_start", reason="起点不可用", detail=obstacle)
            return
        if self.assembly:
            self.selected_start = target
            self.previous_cargo_pose = None
            self.publish_cargo_feedback(self.now(), target)
            self.show_endpoints()
            self.ui("waiting_goal", detail="货物已就位，设置运输终点后才开始集结")
            return
        self.pending_start = target
        self.show_endpoints()
        self.ui("placing", detail="检查并同步放置三车和货物")

    def select_goal(self, message):
        if not self.selection_open():
            return
        pose = planar_pose(message.pose)
        self.last_selected_goal = pose_tuple(pose) if pose is not None and message.header.frame_id == "map" else None
        self.log_operator("select_goal", frame=message.header.frame_id, pose=self.last_selected_goal)
        if not any((self.pending_start, self.selected_start, self.placing)):
            self.ui("waiting_start", reason="缺少起点", detail="请先用 2D Pose Estimate 设置编队起点")
            return
        if message.header.frame_id != "map" or pose is None:
            self.pending_goal = None
            self.show_endpoints()
            self.ui("waiting_goal", reason="终点无效", detail="请选择 map 坐标系中的有限位姿")
            return
        target = pose_tuple(pose)
        if self.assembly:
            target = cargo_reference(target, self.scene.cargo.offset)
            obstruction = self.placement.obstruction(target)
            if obstruction:
                self.pending_goal = None
                self.show_endpoints()
                self.ui("waiting_goal", reason="终点不可用", detail=obstruction)
                return
        self.pending_goal = target
        self.show_endpoints()
        self.ui("placing" if self.selected_start is None else "waiting_goal",
                detail="已收到终点，等待三车起点同步并确认停稳")

    def fleet_stopped(self):
        return all(hypot(*self.odom[i][3][:2]) <= self.timing.stop_speed
                   and abs(self.odom[i][3][2]) <= self.timing.stop_yaw_rate
                   and not any(self.commands[i]) for i in self.spawns)

    def tick_selection(self, now, wall, stale):
        if self.assembly:
            if self.selected_start is None or self.pending_goal is None or stale or not self.planner_ready():
                return
            if not self.fleet_stopped():
                return
            self.execution_started_wall = wall
            self.config.update(start=self.selected_start, goal=self.pending_goal)
            endpoints = {key: list(self.config[key]) for key in ("start", "goal")}
            (self.directory / "selected_endpoints.yaml").write_text(yaml.safe_dump(endpoints, sort_keys=False))
            self.assembly.begin()
            return
        if self.pending_start is not None and not stale and self.fleet_stopped():
            reference, self.pending_start = self.pending_start, None
            self.placing = None
            self.placement_still_since = None
            if not self.placement.place(reference):
                self.pending_goal = None
                self.show_endpoints()
                self.ui("waiting_start", reason="Gazebo 放置失败", detail="请重新选择编队起点")
                return
            self.placing = reference, self.placement.vehicle_poses(reference), monotonic() + 4.
            self.previous_cargo_pose = None
            self.ui("placing", detail="正在确认 Gazebo 位姿和三车停稳反馈")
            return
        if self.placing is not None:
            reference, poses, deadline = self.placing
            if wall >= deadline:
                self.placing = self.pending_goal = None
                self.show_endpoints()
                self.ui("waiting_start", reason="Gazebo 起点同步超时", detail="三车位姿或停稳反馈尚未一致")
                return
            def at_target(pose, target):
                return dist(pose[:2], target[:2]) <= .003 and abs(wrap(pose[2] - target[2])) <= .003

            settled = (not stale and self.fleet_stopped()
                       and all(at_target(self.truth[i][1], poses[i]) and at_target(self.odom[i][2], poses[i])
                               for i in self.spawns))
            if not settled:
                self.placement_still_since = None
            elif self.placement_still_since is None:
                self.placement_still_since = now
            elif now - self.placement_still_since >= .15:
                self.placing = None
                if self.pending_start is None:
                    self.selected_start = reference
                    self.ui("waiting_goal", detail="Gazebo 三车与货物已对齐。用 2D Goal Pose 设置编队终点")
            return
        if self.selected_start is None or self.pending_goal is None or stale or (self.native and not self.planner_ready()):
            return
        self.execution_started_wall = wall
        self.spawns = self.placement.vehicle_poses(self.selected_start)
        self.config.update(start=self.selected_start, goal=self.pending_goal)
        endpoints = {key: list(self.config[key]) for key in ("start", "goal")}
        (self.directory / "selected_endpoints.yaml").write_text(yaml.safe_dump(endpoints, sort_keys=False))
        self.initialize_planner()

    def select_archived_endpoints(self, endpoints):
        if self.assembly:
            endpoints = {key: local_pose(pose, self.scene.cargo.offset) for key, pose in endpoints.items()}
        start = self.stamped_pose(endpoints["start"])
        initial = PoseWithCovarianceStamped(header=start.header)
        initial.pose.pose = start.pose
        self.select_start(initial)
        self.select_goal(self.stamped_pose(endpoints["goal"]))

    def now(self):
        return self.get_clock().now().nanoseconds * 1e-9

    def trace(self, event, *, plan_id=None, vehicle_id=None, **fields):
        # Single-task experiments publish a single goal to freshly launched planners.
        if plan_id is None:
            plan_id = self.request.plan_id if self.request else 1
        self.trace_events.append(dict(event=event, run_id=self.directory.name, plan_id=plan_id,
                                      vehicle_id=vehicle_id, wall_s=monotonic(),
                                      ros_time_ns=self.get_clock().now().nanoseconds, **fields))

    def on_map(self, grid):
        origin = grid.info.origin
        self.map_matches = (grid.header.frame_id == "map"
                            and (grid.info.height, grid.info.width) == self.map_shape
                            and abs(grid.info.resolution - self.scene.resolution) < 1e-6
                            and (origin.position.x, origin.position.y, origin.orientation.w) == (0., 0., 1.)
                            and grid.data == self.map_bytes)
        if not self.map_matches:
            self.finish("failed", "map_differs_from_scene")

    def on_odom(self, index, msg):
        pose = planar_pose(msg.pose.pose)
        v = msg.twist.twist
        velocity = (v.linear.x, v.linear.y, v.angular.z)
        stamp = stamp_ns(msg.header.stamp)
        if (msg.header.frame_id != "map" or msg.child_frame_id != f"robot{index}/base_link"
                or pose is None or stamp <= 0 or not all(map(isfinite, velocity))):
            self.odom.pop(index, None)
        else:
            self.odom[index] = (stamp * 1e-9, monotonic(), pose_tuple(pose), velocity)

    def on_truth(self, index, msg):
        pose = planar_pose(msg.pose)
        if msg.header.frame_id != "map" or pose is None:
            self.truth.pop(index, None)
        else:
            self.truth[index] = (monotonic(), pose_tuple(pose))

    def on_mode(self, index, msg):
        if msg.data in tuple(Mode):
            self.modes[index] = (self.now(), monotonic(), msg.data)
        else:
            self.modes.pop(index, None)

    def on_command(self, index, msg):
        values = (msg.linear.x, msg.linear.y, msg.angular.z)
        if not all(map(isfinite, values)):
            self.finish("stopped", f"robot{index}_invalid_twist")
            return
        self.commands[index] = values
        self.command_received_wall[index] = monotonic()
        if self.plan_keys and index not in self.traced_twist and any(values):
            self.traced_twist.add(index)
            self.trace("first_nonzero_twist_received", plan_id=self.plan_keys[index][0],
                       vehicle_id=index)
        if max(map(abs, values)) > 1e-4:
            self.moved.add(index)

    def feedback_fresh(self, index, now, wall):
        odom, mode, truth = (cache.get(index) for cache in (self.odom, self.modes, self.truth))
        timing = self.timing
        # The wall bound also catches a paused or disconnected source.
        return (odom and mode and truth
                and -timing.clock_tolerance <= now - odom[0] <= timing.state_timeout
                and -timing.clock_tolerance <= now - mode[0] <= timing.mode_timeout
                and max(wall - odom[1], wall - mode[1], wall - truth[0]) <= 1.)

    def stamped_pose(self, values):
        x, y, yaw = values
        msg = PoseStamped()
        msg.header.frame_id = "map"
        msg.header.stamp = self.get_clock().now().to_msg()
        msg.pose.position.x, msg.pose.position.y = float(x), float(y)
        msg.pose.orientation.z, msg.pose.orientation.w = sin(yaw / 2), cos(yaw / 2)
        return msg

    def initialize_planner(self):
        poses = {i: self.truth[i][1] for i in self.spawns}
        for i, pose in poses.items():
            if dist(pose[:2], self.spawns[i][:2]) > .003 or abs(wrap(pose[2] - self.spawns[i][2])) > .003:
                self.finish("failed", f"robot{i}_spawn_pose_mismatch")
                return
        self.initial = poses
        self.reference = (fit_reference(self.scene.offsets, [poses[i] for i in self.spawns])
                          if self.multi else poses[1])
        if self.start_pub is not None:
            initial = self.stamped_pose(self.reference)
            if self.multi:
                reset = PoseWithCovarianceStamped(header=initial.header)
                reset.pose.pose = initial.pose
                self.start_pub.publish(reset)
            else:
                self.start_pub.publish(initial)
        self.request_after = monotonic() + .50
        self.phase = "initializing_planner"

    def enter_transport(self, assembly, plan_id):
        offsets = tuple(assembly["offsets"][i] for i in self.spawns)
        self.scene = replace(self.scene, offsets=offsets)
        self.metrics.scene = self.scene
        self.initial = {i: self.truth[i][1] for i in self.spawns}
        self.reference = fit_reference(offsets, [self.initial[i] for i in self.spawns])
        if (dist(self.reference[:2], self.config["start"][:2]) > .06
                or abs(wrap(self.reference[2] - self.config["start"][2])) > .10):
            self.finish("stopped", "assembly_cargo_pose_residual")
            return
        self.native_mount_starts = {
            i: (*local_pose(self.reference, offset)[:2], self.odom[i][2][2])
            for i, offset in zip(self.spawns, offsets, strict=True)
        }
        self.assembly_attached = True
        self.transport_plan_id = plan_id
        self.request_after = monotonic()
        self.phase = "initializing_planner"
        self.trace("assembly_docked", assignment=assembly["assignment"], transport_plan_id=plan_id)
        self.ui("transport_planning", detail="三车已对准挂点并停稳，开始 CTS 联合规划")

    def publish_goal(self):
        goal = self.stamped_pose(self.config["goal"])
        self.plan_started = monotonic()
        self.phase = "planning"
        if not self.multi:
            self.trace("request_publish")
            self.goal_pub.publish(goal)
            return
        self.request = FormationPlanRequest(header=goal.header, plan_id=self.transport_plan_id,
                                            formation_id=self.scene.formation_id,
                                            allow_reverse=self.contract["allow_reverse"])
        self.request.formation_start = pose2d(self.reference)
        self.request.formation_goal = pose2d(self.config["goal"])
        for index, offset in zip(self.spawns, self.scene.offsets, strict=True):
            self.request.vehicles.append(FormationVehicleSpec(
                vehicle_id=index, goal_heading_free=self.contract["goal_heading_free"],
                offset_in_formation=Point(x=offset[0], y=offset[1]),
                start_center=pose2d(self.native_mount_starts[index] if self.assembly else self.initial[index]),
                goal_center=pose2d(local_pose(self.config["goal"], offset)),
                body_length_m=self.scene.vehicle_size[0], body_width_m=self.scene.vehicle_size[1]))
        self.trace("request_publish")
        if self.ui_enabled:
            self.solver_outcome = "running"
            self.ui("transport_planning" if self.assembly else "planning", detail="正在求解联合 A/O/S 轨迹")
        self.goal_pub.publish(self.request)

    def on_single(self, msg):
        if self.phase != "planning" or not msg.points:
            return
        self.trace("plan_received", plan_id=msg.plan_id, planner_ros_stamp_ns=stamp_ns(msg.header.stamp))
        self.save_plan(msg, {1: msg})
        self.phase = "running"

    def on_native_single(self, msg):
        if self.phase != "planning" or not msg.trajectory.trajectories:
            return
        track = msg.trajectory.trajectories[0]
        route = TimedTrajectory(header=msg.header, plan_id=msg.plan_id, points=[
            TimedPoint(time_from_start=p.time_from_start, center_pose=p.center_pose,
                       v=p.center_speed_mps, mode=p.mode) for p in track.points])
        self.model_sha256, self.arm_stamp = msg.model_sha256, msg.header.stamp
        self.trace("plan_received", plan_id=msg.plan_id, model_sha256=msg.model_sha256,
                   planner_ros_stamp_ns=stamp_ns(msg.header.stamp))
        self.save_plan(route, {1: route})
        path = self.directory / "trajectories"
        (path / "model.json").write_text(msg.model_json)
        self.planner_source = "hybrid_joint"
        self.phase = "arming"
        if self.native_release:
            self.native_running()

    def on_native_admission(self, msg):
        event = json.loads(msg.data)
        if not self.plan_started or self.result or not event.get("plan_id"):
            return
        if self.multi and (not self.request or event["plan_id"] != self.request.plan_id):
            return
        self.trace("native_group_admission", **event)
        if event["phase"] == "STOPPED":
            self.finish("stopped", event["reason"])
        elif event["phase"] == "AUTHORIZED":
            self.native_release = event
            if self.plan_keys and self.phase == "arming":
                self.native_running()

    def native_running(self):
        event = self.native_release
        if (event["model_sha256"] != self.model_sha256
                or event["start_ns"] != stamp_ns(self.arm_stamp)):
            self.finish("stopped", "group_admission_identity_mismatch")
            return
        self.phase = "running"
        self.admitted.update(self.spawns)
        self.trace("permit_enabled", start_ns=event["start_ns"])
        self.ui("transport_executing" if self.assembly else "running", detail="三车已通过 C++ 联合准入，按同一时刻起步")

    def on_formation(self, msg):
        if (self.phase not in ("planning", "waiting_for_plan_validation", "arming", "running")
                or msg.plan_id != self.request.plan_id):
            return
        if self.formation_plan is not None:
            if not msg.trajectory.trajectories or msg.model_sha256 != self.model_sha256:
                self.finish("stopped", "formation_plan_invalidated")
            return
        if not msg.trajectory.trajectories:
            return  # The planner clears previous data before publishing a new result.
        archive_path = self.directory / "trajectories"
        (archive_path / "planner.cdr").write_bytes(serialize_message(msg))
        if self.archive and msg.model_json:
            (archive_path / "model.json").write_text(msg.model_json)
        self.trace("plan_received", model_sha256=msg.model_sha256,
                   planner_ros_stamp_ns=stamp_ns(msg.header.stamp))
        if self.native:
            # These projections feed only experiment logging and display. The independent
            # C++ coordinator owns recertification, group start and all permits.
            self.arm_stamp = msg.header.stamp
            self.model_sha256 = msg.model_sha256
            self.formation_plan = msg
            if self.assembly:
                phases = json.loads(msg.model_json)["phases"]
                if phases[-1]["mode"] == int(Mode.SPIN) and len(phases) >= 2:
                    self.alignment_start_s = sum(p["duration"] for p in phases[:-2])
            self.cargo_plan_times = tuple(stamp_ns(point) for point in msg.trajectory.times_from_start)
            projections = {
                track.vehicle_id: TimedTrajectory(header=msg.header, plan_id=msg.plan_id, points=[
                    TimedPoint(time_from_start=p.time_from_start, center_pose=p.center_pose,
                               v=p.center_speed_mps, mode=p.mode) for p in track.points])
                for track in msg.trajectory.trajectories}
            self.save_plan(msg, projections)
            self.planner_source = "hybrid_joint"
            self.phase = "arming"
            self.ui("arming", detail="等待 C++ 三车联合准入")
            if self.native_release:
                self.native_running()
            return
        try:
            routes = make_routes(msg, self.request, msg.header.stamp,
                                 expected_backend=self.formation_backend)
        except ValueError as error:
            self.get_logger().error(str(error))
            self.finish("stopped", "invalid_formation_trajectory")
            return
        self.model_sha256 = msg.model_sha256
        self.formation_plan, self.formation_routes = msg, routes
        self.cargo_plan_times = tuple(stamp_ns(point) for point in msg.trajectory.times_from_start)
        self.plan_wall = monotonic() - self.plan_started
        self.trace("routes_verified", model_sha256=msg.model_sha256)
        self.phase = "waiting_for_plan_validation"
        self.ui("verification", detail="已收到轨迹，正在确认共同模型")

    def on_job(self, msg):
        self.job = json.loads(msg.data)
        if (self.execution_without_playback and self.phase in ("arming", "running")
                and self.job.get("plan_id") == self.request.plan_id
                and self.job.get("backend") == self.formation_backend
                and (self.job.get("execution_verified") is not True
                     or self.job.get("model_sha256") != self.model_sha256)):
            self.finish("stopped", "formation_verification_revoked")

    def arm_formation(self):
        lead = self.config["coordination"]["lead_s"]
        start_ns = self.get_clock().now().nanoseconds + round(lead * NSEC)
        sec, nanosec = divmod(start_ns, NSEC)
        self.arm_stamp = Time(sec=sec, nanosec=nanosec)
        msg, routes = self.formation_plan, self.formation_routes
        for route in routes.values():
            route.header.stamp = self.arm_stamp
        self.save_plan(msg, routes)
        self.phase = "arming"
        for index, route in routes.items():
            self.routes[index].publish(route)
        self.ui("arming", detail="等待三车控制器预检通过")
        self.trace("routes_published", model_sha256=self.model_sha256, start_ns=start_ns)
        self.get_logger().info(f"Routed plan {msg.plan_id} to {sorted(routes)} at common time {start_ns} ns")

    def save_plan(self, msg, routes):
        if self.plan_wall is None:
            self.plan_wall = monotonic() - self.plan_started
        self.plan_keys = {i: (route.plan_id, stamp_ns(route.header.stamp)) for i, route in routes.items()}
        self.duration = stamp_ns(next(iter(routes.values())).points[-1].time_from_start) / NSEC
        path = self.directory / "trajectories"
        if not self.multi:
            (path / "planner.cdr").write_bytes(serialize_message(msg))
        for i, route in routes.items():
            if self.archive is None:
                (path / f"robot{i}.cdr").write_bytes(serialize_message(route))
            last = route.points[-1].center_pose
            self.goals[i] = (last.x, last.y, last.theta)

    def on_planner(self, topic, msg):
        self.planner_log.write(json.dumps({"topic": topic, "wall_s": monotonic() - self.boot_wall,
                                           "message": msg.data}, ensure_ascii=False) + "\n")
        if self.multi:
            status = json.loads(msg.data)
            if (self.request and status.get("plan_id") == self.request.plan_id
                    and status.get("node_state") == "PUBLISHED"):
                self.trace("planner_publication_status_received",
                           planning_stages=status.get("planning_stages", {}),
                           envelope_verification_wall_s=status.get("envelope_verification_wall_s"))
                if self.ui_enabled and self.result is None:
                    self.terminal_alignment = status.get("terminal_alignment", "not_requested")
                    degraded = status.get("planning_stages", {}).get("policy_status") == "FEASIBLE_POLICY_DEGRADED"
                    self.solver_outcome = "degraded" if degraded else "success"
                    self.solver_elapsed_s = ((status.get("wall_time_s") or 0.)
                                             + (status.get("envelope_verification_wall_s") or 0.))
                    phase = self.phase if self.phase in ("arming", "running") else "verification"
                    self.ui("transport_planning" if self.assembly and phase != "running" else phase,
                            detail="规划与模型信封认证通过")
            self.planner_status[topic] = {k: status[k] for k in (
                "plan_id", "node_state", "status", "code", "reason", "detail", "trajectory_published",
                "first_failure_layer", "duration_s") if k in status}
            if (self.phase in ("planning", "waiting_for_plan_validation", "arming", "running") and self.request is not None
                    and status.get("plan_id") == self.request.plan_id
                    and (status.get("node_state") in ("FAILED", "REJECTED")
                         or status.get("status") in ("REJECTED", "FAILED", "INVALID"))):
                if self.ui_enabled:
                    self.solver_outcome = "failed"
                    self.solver_elapsed_s = status.get("wall_time_s")
                self.finish("stopped" if self.plan_keys else "failed",
                            status.get("reason") or status.get("code") or "formation_planning_failed",
                            detail=status.get("detail", ""))
        else:
            self.planner_status[topic] = msg.data
            if self.native and topic == "/plan/status" and msg.data.startswith("success ") and " stages=" in msg.data:
                metadata, stages = msg.data.split(" stages=", 1)
                identifier = next((word[3:] for word in metadata.split() if word.startswith("id=")), "")
                if self.plan_started and identifier.isdecimal():
                    self.trace("planner_publication_status_received", plan_id=int(identifier),
                               planning_stages=json.loads(stages))
            if topic == "/plan/status" and msg.data.startswith("success ") and self.planner_source is None:
                self.planner_source = next(
                    (part.removeprefix("source=") for part in msg.data.split()
                     if part.startswith("source=")), None)
                if self.planner_source:
                    self.get_logger().info(f"Single-vehicle plan source: {self.planner_source}")
            if self.phase == "planning" and msg.data.startswith((
                "search_no_path", "search_budget_exhausted", "action_policy_rejected",
                "missing_map_or_start ", "invalid_goal_frame ",
                "rejected ", "frontend_rejected ", "geometry_only ", "reverse_coarse_seed_rejected ",
            )):
                self.finish("failed", msg.data)

    def on_controller(self, index, msg):
        row = json.loads(msg.data)
        if self.assembly and not self.assembly_attached:
            self.assembly.on_controller(index, row)
        if self.archive is None or self.result is None:
            self.controller_log.record(index, row, monotonic())
        key = (row.get("plan_id"), row.get("trajectory_stamp_ns"))
        if self.plan_keys is None or self.plan_keys.get(index) != key or row.get("result") == "CLEARED":
            return
        self.controller_age[index] = (self.now(), monotonic())
        phase = row.get("phase")
        if row["kind"] == "admission":
            self.trace("controller_admission_received", plan_id=key[0], vehicle_id=index,
                       result=row.get("result"), start_ns=key[1])
            if row.get("result") in ("PASS", "WARN") and phase in ("TRACKING", "WAIT_START"):
                self.admitted.add(index)
                if self.result is None:
                    self.ui("arming", detail="等待三车控制器预检通过")
            else:
                self.finish("stopped", f"robot{index}_trajectory_{phase or row.get('result')}")
        if index in self.admitted:
            self.metrics.controller(index, row)
            if phase == "COMPLETE":
                new = index not in self.complete
                self.complete.add(index)
                if new and self.result is None:
                    self.ui("running", detail="等待编队全部完成停车")
            elif phase in ("STOPPED", "REJECTED", "STALE_TRAJECTORY"):
                reasons = ",".join(row.get("reasons", ())) or phase
                self.finish("stopped", f"robot{index}:{reasons}")
        self.controller_status[index] = {k: row[k] for k in ("phase", "result", "reasons") if k in row}

    def permit(self, enabled):
        if not self.native and self.arm_stamp is not None and rclpy.ok():
            self.permit_pub.publish(FormationExecutionPermit(
                stamp=self.get_clock().now().to_msg(), start=self.arm_stamp,
                plan_id=self.request.plan_id, enabled=enabled))

    def tick(self):
        wall = monotonic()
        now = self.now()
        stale = [i for i in self.spawns if not self.feedback_fresh(i, now, wall)]
        can_measure = not stale or (self.result is not None and all(
            i in self.truth and wall - self.truth[i][0] <= 1. for i in self.spawns))
        monitor_formation = self.interactive and self.placing is None and now > 0.
        if can_measure and (self.initial or monitor_formation) and wall - self.measure_wall >= .1:
            self.measurement(now, record=self.initial is not None and (not self.interactive or self.result is None))
            self.measure_wall = wall
        if self.result:
            self.permit(False)
            if self.assembly and not self.assembly_attached:
                self.assembly.permit(False)
            if self.interactive and self.final_observation is None and wall >= self.observation_due_wall:
                self.write_result()
            return
        if self.replay_mismatch:
            self.finish("failed", "replay_scene_mismatch", detail=f"现场文件与归档不一致 · {self.replay_mismatch}")
            return
        deadline_origin = self.execution_started_wall if self.interactive else self.boot_wall
        if deadline_origin is not None and wall - deadline_origin >= self.config["timeout_s"]:
            self.finish("timed_out", self.phase)
            return
        if self.interactive and self.phase in ("waiting_for_simulation", "waiting_for_planner") and wall - self.boot_wall > 45.:
            self.finish("timed_out", self.phase, detail="Gazebo、地图或规划器启动未就绪")
            return
        if self.phase == "waiting_for_simulation":
            if now > 0. and self.map_matches and not stale and self.commands.keys() == self.spawns.keys():
                self.phase = "waiting_for_planner"
                print("COPTRANS_SIMULATION_READY", flush=True)
        elif self.phase == "waiting_for_planner":
            if (not stale and (self.start_pub is None or self.start_pub.get_subscription_count() >= 1)
                    and self.goal_subscribers_ready()):
                if self.assembly and not self.interactive and self.fleet_stopped():
                    self.assembly.begin()
                elif not self.interactive and not self.assembly:
                    self.initialize_planner()
                elif self.interactive and self.planner_ready():
                    self.phase = "interactive_selection"
                    self.ui("waiting_start", detail="用 2D Pose Estimate 设置编队起点")
                    if self.config.get("replay_endpoints"):
                        self.select_archived_endpoints(self.config["replay_endpoints"])
        elif self.phase == "interactive_selection":
            self.tick_selection(now, wall, stale)
        elif self.assembly and (self.phase.startswith("assembly_") or self.phase == "docking"):
            self.assembly.tick(now, wall, stale)
        elif self.phase == "initializing_planner":
            if not stale and wall >= self.request_after and self.planner_ready():
                self.publish_goal()
        elif self.phase == "waiting_for_plan_validation":
            verified = (self.job.get("execution_verified") is True if self.execution_without_playback
                        else self.job.get("state") in ("PLAYING", "HOLD_END"))
            if (not stale and verified
                    and self.job.get("backend") == self.formation_backend
                    and self.job.get("formation_id") == self.request.formation_id
                    and self.job.get("plan_id") == self.request.plan_id
                    and self.job.get("model_sha256") == self.model_sha256):
                self.arm_formation()
        elif self.phase in ("arming", "running"):
            self.execute(now, wall, stale)

    def goal_subscribers_ready(self):
        if self.native:
            names = {endpoint.node_name for endpoint in self.get_subscriptions_info_by_topic(self.goal_pub.topic_name)}
            return (self.planner_ready() and self.goal_pub.get_subscription_count() >= 2
                    and (self.start_pub is None or self.start_pub.get_subscription_count() >= 2)
                    and {"hybrid_joint_planner", "hybrid_joint_executor"} <= names)
        if not self.multi:
            return self.goal_pub.get_subscription_count() >= 1
        endpoints = self.get_subscriptions_info_by_topic(self.goal_pub.topic_name)
        listeners = {endpoint.node_name for endpoint in endpoints}
        if self.formation_backend == PLAYBACK_PLAN_BACKEND:
            # Uniform playback verifies the atomic envelope and does not
            # retain the original request when its transport UI is disabled.
            return "formation_uniform_planner" in listeners
        return {"formation_uniform_planner", "formation_playback"} <= listeners

    def planner_ready(self):
        if self.native:
            return self.native_ready.ready(self.get_clock().now().nanoseconds,monotonic())
        if self.multi:
            return (self.job.get("backend") == self.formation_backend
                    and self.job.get("map_ready") and self.job.get("map_frame_id") == "map"
                    and (self.start_pub is None or self.job.get("initial_reset_ready")))
        height, width = self.map_shape
        ready = f"map_ready {width}x{height}"
        return all(self.planner_status.get(topic) == ready for topic in string_topics(False))

    def execute(self, now, wall, stale):
        if stale:
            self.finish("stopped", f"robot{stale[0]}_stale_or_invalid_feedback")
            return
        if self.native:
            if (self.assembly and self.alignment_start_s is not None and not self.in_terminal_alignment
                    and self.terminal_alignment == "aligned" and self.phase == "running"
                    and now >= stamp_ns(self.arm_stamp) / NSEC + self.alignment_start_s):
                self.in_terminal_alignment = True
                self.ui("terminal_alignment", detail="货物位姿保持，三车安全原地对齐")
            if self.complete == self.spawns.keys():
                self.check_result()
            return
        if self.phase == "arming":
            deadline = stamp_ns(self.arm_stamp) / NSEC - self.config["coordination"]["release_margin_s"]
            if now >= deadline:
                self.finish("stopped", "formation_admission_deadline")
            elif self.admitted == self.spawns.keys():
                self.phase = "running"
                self.trace("permit_enabled", start_ns=stamp_ns(self.arm_stamp))
                self.permit(True)
                self.ui("running", detail="共用执行许可已发出，三车使用同一启动时刻")
            return
        if self.complete == self.spawns.keys():
            self.check_result()
        elif self.multi:
            for i in self.spawns:
                stamp, received = self.controller_age[i]
                if now - stamp > self.timing.state_timeout or wall - received > 1.:
                    self.finish("stopped", f"robot{i}_controller_status_timeout")
                    return
            self.permit(True)

    def measurement(self, stamp, *, record=True):
        if self.assembly and not self.assembly_attached:
            return
        poses = {i: self.truth[i][1] for i in self.spawns}
        if record:
            if self.previous_measurement is not None:
                self.last_ground_truth_step = {i: dist(poses[i][:2], self.previous_measurement[i][:2])
                                               for i in self.spawns}
            self.previous_measurement = poses
            observed = {i: row[3] for i, row in self.odom.items()}
            modes = {i: row[2] for i, row in self.modes.items()}
            reference = self.metrics.sample(stamp, poses, self.commands, measured=observed, modes=modes)
        elif self.multi:
            reference = fit_reference(self.scene.offsets, [poses[i] for i in self.spawns])
        if self.multi:
            self.publish_cargo_feedback(stamp, reference)
            mount = max(dist(poses[i][:2], local_pose(reference, offset)[:2])
                        for i, offset in zip(self.spawns, self.scene.offsets, strict=True))
            self.mount_pub.publish(Float64(data=mount))
            spacing = max(abs(dist(poses[i][:2], poses[j][:2]) - dist(a, b))
                          for (i, a), (j, b) in combinations(zip(self.spawns, self.scene.offsets, strict=True), 2))
            self.max_spacing_error = max(self.max_spacing_error, spacing)
            self.spacing_pub.publish(Float64(data=spacing))

    def publish_cargo_feedback(self, stamp, reference):
        stamp_nsec = round(stamp * NSEC)
        seconds, nanoseconds = divmod(stamp_nsec, NSEC)
        msg = self.stamped_pose(reference)
        msg.header.stamp = Time(sec=seconds, nanosec=nanoseconds)
        msg.pose.position.z = self.scene.cargo.bottom
        cargo = Odometry(header=msg.header, child_frame_id="cargo/base_link")
        cargo.pose.pose = msg.pose
        pose = Pose(*reference)
        center = Pose(*local_pose(reference, self.scene.cargo.offset))
        if self.previous_cargo_pose is not None:
            previous_stamp, previous_pose = self.previous_cargo_pose
            if stamp > previous_stamp:
                twist = between(previous_pose, center, stamp - previous_stamp)
                cargo.twist.twist.linear.x, cargo.twist.twist.linear.y = twist.vx, twist.vy
                cargo.twist.twist.angular.z = twist.wz
                self.max_cargo_speed = max(self.max_cargo_speed, hypot(twist.vx, twist.vy))
        self.previous_cargo_pose = stamp, center
        self.cargo_pub.publish(cargo)

        if self.arm_stamp is None or self.phase != "running":
            return
        start_nsec = stamp_ns(self.arm_stamp)
        elapsed = stamp_nsec - start_nsec
        if elapsed < 0:
            return
        # The archived planner stamp describes playback. The trackers start on
        # the coordinated arm stamp, with the same relative time axis.
        trajectory = self.formation_plan.trajectory
        upper = bisect_right(self.cargo_plan_times, elapsed)
        first = trajectory.formation_poses[upper - 1]
        target = Pose(first.x, first.y, first.theta)
        if upper < len(self.cargo_plan_times):
            second = trajectory.formation_poses[upper]
            lower_time = self.cargo_plan_times[upper - 1]
            fraction = (elapsed - lower_time) / (self.cargo_plan_times[upper] - lower_time)
            target = Pose(first.x + fraction * (second.x - first.x),
                          first.y + fraction * (second.y - first.y),
                          first.theta + fraction * wrap(second.theta - first.theta))
        phase = "COMPLETE" if self.complete == self.spawns.keys() else "TRACKING"
        if self.result and self.result["status"] != "passed":
            phase = "STOPPED"
        status = {"kind": "execution", "plan_id": trajectory.plan_id, "trajectory_stamp_ns": start_nsec,
                  "stamp": stamp, "phase": phase, "body_error": pose.error_to(target)}
        self.cargo_status_pub.publish(String(data=json.dumps(status, allow_nan=False)))

    def check_result(self):
        self.measurement(self.now())
        limits = self.config["acceptance"]
        summary = self.summary()
        errors = summary["vehicles"].values()
        if (self.moved != self.spawns.keys() or any(
            r["terminal_position_error_m"] > limits["terminal_position_m"]
            or r["terminal_yaw_error_deg"] > degrees(limits["terminal_yaw_rad"])
            or r["travel_from_spawn_m"] < .01 for r in errors
        )):
            self.finish("failed", "terminal_tracking_error_or_no_motion")
        elif any(row["m"] <= 0. for row in summary["min_environment_clearance"].values()):
            self.finish("failed", "sampled_environment_contact")
        elif not self.multi and (summary["requested_goal_position_error_m"] > limits["terminal_position_m"]
                                 or summary["requested_goal_yaw_error_deg"] > degrees(limits["terminal_yaw_rad"])):
            self.finish("failed", "requested_goal_error")
        elif self.multi and (summary["min_vehicle_footprint_gap_m"] <= 0.
                             or summary["max_mount_error_m"] > limits["max_mount_error_m"]
                             or summary["terminal_formation_position_error_m"] > limits["terminal_position_m"]
                             or summary["terminal_formation_yaw_error_deg"] > degrees(limits["terminal_yaw_rad"])):
            self.finish("failed", "formation_tracking_or_clearance_error")
        else:
            self.finish("passed", "all_trackers_complete")

    def velocity_observation(self, wall):
        return {
            "captured_wall_s": wall,
            "captured_ros_s": self.now(),
            "cmd_vel": {i: {"velocity": list(v), "received_wall_s": self.command_received_wall[i]}
                        for i, v in self.commands.items()},
            "odom": {i: {"velocity": list(row[3]), "source_ros_s": row[0], "received_wall_s": row[1]}
                     for i, row in self.odom.items()},
        }

    def finish(self, status, reason, *, detail=""):
        if self.result is not None:
            return
        self.get_logger().info(f"Experiment {status} ({reason})")
        if self.plan_wall is None and self.plan_started is not None:
            self.plan_wall = monotonic() - self.plan_started
        decided = monotonic()
        self.decision_observation = self.velocity_observation(decided)
        observe = status == "passed" or bool(self.arm_stamp or self.plan_keys or self.moved
                                             or (self.assembly and self.assembly.epoch))
        self.observation_due_wall = decided + (self.config["observation_s"] if observe else 0.)
        self.result = {"status": status, "reason": reason, "detail": detail, "phase_at_end": self.phase}
        self.permit(False)
        if self.assembly:
            self.assembly.permit(False)
        if status in ("failed", "stopped", "timed_out"):
            if self.native_cancel and rclpy.ok():
                self.native_cancel.publish(String(data=reason))
            self.controller_log.save_fault_tail(monotonic())
        self.trace("finish", result=status, reason=reason)
        if self.ui_enabled:
            if self.solver_outcome == "running":
                self.solver_outcome = "failed"
            if self.solver_elapsed_s is None:
                self.solver_elapsed_s = self.plan_wall
            if not detail:
                detail = "三车已完成并停车" if status == "passed" else "三车执行停车"
            self.ui("finished" if status == "passed" else "failed", reason="" if status == "passed" else reason,
                    detail=detail + "\n按 Ctrl+C 退出，重新运行脚本开始下一轮。")
            if self.interactive:
                self.write_result()
                return
        self.end_wall = self.observation_due_wall

    def summary(self):
        final = {i: row[1] for i, row in self.truth.items()}
        summary = self.metrics.summary(self.initial or {}, final, self.goals, self.config["goal"])
        if self.multi:
            summary.update(max_pairwise_spacing_error_m=self.max_spacing_error,
                           maximum_cargo_center_speed_mps=self.max_cargo_speed)
        return summary

    def termination_fields(self, *, closing):
        wall = monotonic()
        if self.final_observation is None and (closing or wall >= self.observation_due_wall):
            self.final_observation = self.velocity_observation(wall)
            self.final_observation["window_complete"] = wall >= self.observation_due_wall
            decided = self.decision_observation["captured_wall_s"]
            for topic in ("cmd_vel", "odom"):
                self.final_observation["fresh_" + topic + "_vehicles"] = sorted(
                    i for i, row in self.final_observation[topic].items() if row["received_wall_s"] > decided)
        snapshot = self.final_observation or self.decision_observation
        return {
            "final_cmd_vel": {i: row["velocity"] for i, row in snapshot["cmd_vel"].items()},
            "last_odom_twist": {i: row["velocity"] for i, row in snapshot["odom"].items()},
            "termination_observation": {"decision": self.decision_observation, "due_wall_s": self.observation_due_wall,
                                        "final": self.final_observation},
        }

    def write_result(self, *, closing=False):
        if self.result is None:
            self.finish("cancelled", "launch_shutdown_before_completion")
        data = dict(self.result, scenario=self.scene.name, task=self.config["task"],
                    experiment=self.config["experiment"], planner=self.config["planner_backend"],
                    planner_source=self.planner_source,
                    controller=self.config["controller_backend"], formation=self.config["formation"],
                    architecture_profile=self.config.get("architecture_profile", "baseline"),
                    speed_profile=self.config.get("speed_profile", "baseline"),
                    tracking_implementation=self.config.get("tracking_implementation", "python"),
                    formation_offsets_m=self.scene.offsets if self.multi else None,
                    map_matches_generated=self.map_matches, observed_spawn=self.initial,
                    plan_received=self.plan_keys is not None or self.formation_plan is not None,
                    planner_wall_s=self.plan_wall,
                    plan_duration_s=self.duration, routed_plan_keys=self.plan_keys,
                    planner_status=self.planner_status, controller_status=self.controller_status,
                    admitted=sorted(self.admitted), complete=sorted(self.complete),
                    last_ground_truth_step_m=self.last_ground_truth_step,
                    metrics=self.summary(), **self.termination_fields(closing=closing))
        data.update(experiment_id=self.experiment_id, replay_of=self.config.get("replay_of"),
                    start=self.config["start"], goal=self.config["goal"],
                    model_sha256=getattr(self, "model_sha256", None))
        if self.assembly:
            assembly = self.assembly.run or {}
            data.update(assembly_status=assembly.get("status"), cts_case=self.config.get("cts_case"),
                        dock_assignment=assembly.get("assignment"), docked=self.docked,
                        assembly_elapsed_s=self.assembly_elapsed_s,
                        assembly_duration_s=assembly.get("duration_s"),
                        assembly_min_measured_pair_gap_m=self.assembly.min_measured_gap,
                        terminal_alignment=self.terminal_alignment,
                        cargo_centers={key: list(local_pose(self.config[key], self.scene.cargo.offset))
                                       for key in ("start", "goal")})
        if self.interactive:
            data.update(interactive=True, selected_start=self.selected_start, selected_goal=self.pending_goal,
                        start=self.selected_start or self.last_selected_start,
                        goal=self.pending_goal or self.last_selected_goal,
                        solver_elapsed_s=self.solver_elapsed_s, solver_outcome=self.solver_outcome)
        path = self.directory / "result.yaml"
        temp = path.with_suffix(".partial")
        temp.write_text(yaml.safe_dump(data, sort_keys=False))
        temp.replace(path)
        (self.directory / "timing_trace.jsonl").write_text(
            "".join(json.dumps(row, allow_nan=False) + "\n" for row in self.trace_events))
        if self.archive is not None and self.interactive:
            try:
                collect(self.directory, self.archive)
            except (OSError, ValueError) as error:
                self.get_logger().error(f"Local archive checkpoint failed: {error}")


def main():
    rclpy.init(signal_handler_options=SignalHandlerOptions.SIGTERM)
    node = RunExperiment()
    try:
        while rclpy.ok() and (node.end_wall is None or monotonic() < node.end_wall):
            rclpy.spin_once(node, timeout_sec=.08)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    except Exception as error:
        node.finish("failed", f"runtime_error:{type(error).__name__}: {error}")
        raise
    finally:
        node.write_result(closing=True)
        if node.assembly:
            node.assembly.close()
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
