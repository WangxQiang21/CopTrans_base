 namespace casadi {
+  class X0IncumbentHeuristic : public CbcHeuristic {
+  public:
+    X0IncumbentHeuristic(const std::vector<double>& seed,
+                         Ipopt::SmartPtr<Bonmin::TMINLP> tminlp)
+      : seed_(seed), tminlp_(tminlp), used_(false), injected_(false) {}
+    X0IncumbentHeuristic(const X0IncumbentHeuristic& other)
+      : CbcHeuristic(other), seed_(other.seed_), tminlp_(other.tminlp_),
+        used_(other.used_), injected_(other.injected_) {}
+    CbcHeuristic* clone() const override {
+      return new X0IncumbentHeuristic(*this);
+    }
+    void resetModel(CbcModel* model) override { setModel(model); }
+    void setModel(CbcModel* model) override {
+      CbcHeuristic::setModel(model);
+      if (injected_ || !model || !model->solver() ||
+          model->solver()->getNumCols() != static_cast<int>(seed_.size()))
+        return;
+      Ipopt::Number value = 0.0;
+      if (!tminlp_->eval_f(static_cast<Ipopt::Index>(seed_.size()),
+                            seed_.data(), true, value)) return;
+      model->setBestSolution(seed_.data(), static_cast<int>(seed_.size()),
+                             value, false);
+      injected_ = true;
+      std::cerr << "BONMINSEED_CBC_INCUMBENT_INSERTED vars=" << seed_.size()
+                << " objective=" << value << std::endl;
+    }
+    int solution(double& objectiveValue, double* newSolution) override {
+      if (used_ || !model_ || !model_->solver() ||
+          model_->solver()->getNumCols() != static_cast<int>(seed_.size()))
+        return 0;
+      used_ = true;
+      Ipopt::Number value = 0.0;
+      if (!tminlp_->eval_f(static_cast<Ipopt::Index>(seed_.size()),
+                            seed_.data(), true, value)) return 0;
+      if (!(value < objectiveValue)) return 0;
+      std::copy(seed_.begin(), seed_.end(), newSolution);
+      objectiveValue = value;
+      return 1;
+    }
+  private:
+    std::vector<double> seed_;
+    Ipopt::SmartPtr<Bonmin::TMINLP> tminlp_;
+    bool used_;
+    bool injected_;
+  };
