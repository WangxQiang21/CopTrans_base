<?xml version="1.0"?>
<package format="2">
  <name>fwis_v3_playback</name><version>0.1.0</version>
  <description>Time-stamped vehicle-center RViz playback.</description>
  <maintainer email="wq@whut.edu.cn">WangQ</maintainer><license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>rospy</depend><depend>geometry_msgs</depend><depend>visualization_msgs</depend>
  <depend>fwis_v3_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>fwis_v3_optimizer</exec_depend>
  <!-- Optional at runtime: the node logs a warning and keeps the marker
       display when the ROS Noetic jsk_rviz_plugins package is absent. -->
  <exec_depend>jsk_rviz_plugins</exec_depend>
</package>
