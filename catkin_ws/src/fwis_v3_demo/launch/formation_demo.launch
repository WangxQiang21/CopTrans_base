<launch>
  <!-- S10 multi-vehicle formation demo.
       Starts exactly one map publisher, at most one C++ formation front end,
       one Python formation optimizer and one formation playback node.  It
       never starts three single-vehicle planners or the single-vehicle
       optimizer/playback.  Set frontend:=false to drive /formation/plan_seed
       directly (for example from tests/ros_formation_smoke.py). -->
  <arg name="scene" default="S09_underground_garage"/>
  <arg name="map_dir"
       default="$(find fwis_v3_demo)/../../../maps/map16-s09-underground-garage"/>
  <arg name="scene_yaml" default="$(arg map_dir)/scene_source.yaml"/>
  <arg name="rviz" default="false"/>
  <arg name="rviz_config" default="$(find fwis_v3_demo)/rviz/formation_demo.rviz"/>
  <arg name="auto_goal" default="false"/>
  <arg name="config_file"
       default="$(find fwis_v3_demo)/config/formation_params.yaml"/>
  <arg name="start_map" default="true"/>
  <arg name="frontend" default="true"/>
  <arg name="optimizer" default="true"/>
  <arg name="playback" default="true"/>
  <arg name="goal_bridge" default="true"/>
  <arg name="goal_start_x" default="10.0"/>
  <arg name="goal_start_y" default="3.6"/>
  <arg name="goal_start_theta" default="0.0"/>
  <!-- One authoritative transport contract: ids, offsets, body dimensions,
       heading policies.  Loaded into the goal bridge and the playback node;
       tools/transport_footprint.py reads the same file. -->
  <arg name="transport_config"
       default="$(find fwis_v3_demo)/config/transport_formation.yaml"/>
  <arg name="enable_nlp" default="true"/>
  <arg name="max_candidates" default="4"/>
  <arg name="optimizer_time_limit" default="1.0"/>
  <arg name="require_collision_precheck" default="true"/>
  <!-- Legacy restricted experiment only: the transport contract has no
       theta_i=psi_F lock.  Keep false for the default demo. -->
  <arg name="require_cargo_heading" default="false"/>
  <arg name="playback_rate" default="25.0"/>
  <arg name="playback_publish_tf" default="true"/>

  <node if="$(arg start_map)" name="fwis_map_publisher"
        pkg="fwis_map_server" type="map_publisher.py" output="screen">
    <param name="map_dir" value="$(arg map_dir)"/>
  </node>

  <node if="$(arg frontend)" name="formation_planner"
        pkg="fwis_v3_planner" type="formation_planner_node" output="screen">
    <rosparam command="load" file="$(arg config_file)"/>
  </node>

  <node if="$(arg optimizer)" name="formation_optimizer"
        pkg="fwis_v3_optimizer" type="formation_optimizer_node.py"
        output="screen">
    <param name="enable_nlp" value="$(arg enable_nlp)"/>
    <param name="max_candidates" value="$(arg max_candidates)"/>
    <param name="optimizer_time_limit" value="$(arg optimizer_time_limit)"/>
    <param name="require_collision_precheck"
           value="$(arg require_collision_precheck)"/>
    <param name="collision_margin" value="0.05"/>
    <param name="sweep_spacing" value="0.01"/>
    <param name="publication_dt" value="0.02"/>
    <param name="planning_dt" value="0.02"/>
    <param name="kinematic_limits/require_cargo_heading"
           value="$(arg require_cargo_heading)"/>
    <param name="start_on_publication" value="true"/>
  </node>

  <node if="$(arg playback)" name="formation_playback"
        pkg="fwis_v3_playback" type="formation_playback.py"
        output="screen">
    <param name="frame_id" value="map"/>
    <param name="rate" value="$(arg playback_rate)"/>
    <param name="publish_tf" value="$(arg playback_publish_tf)"/>
    <param name="transport_ui" value="true"/>
    <rosparam command="load" file="$(arg transport_config)"/>
  </node>

  <node if="$(arg goal_bridge)" name="formation_goal_bridge"
        pkg="fwis_v3_demo" type="formation_goal_bridge.py"
        output="screen">
    <param name="frame_id" value="map"/>
    <param name="start_x" value="$(arg goal_start_x)"/>
    <param name="start_y" value="$(arg goal_start_y)"/>
    <param name="start_theta" value="$(arg goal_start_theta)"/>
    <param name="initial_plan_id" value="600000"/>
    <param name="map_timeout_s" value="8.0"/>
    <param name="playback_tf_timeout_s" value="0.5"/>
    <rosparam command="load" file="$(arg transport_config)"/>
  </node>

  <node if="$(arg auto_goal)" name="formation_auto_goal"
        pkg="fwis_v3_demo" type="auto_goal.py" output="screen">
    <param name="map_dir" value="$(arg map_dir)"/>
  </node>

  <node if="$(arg rviz)" name="rviz" pkg="rviz" type="rviz"
        args="-d $(arg rviz_config)"
        output="screen"/>
</launch>
