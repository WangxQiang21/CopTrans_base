<launch>
  <arg name="scene"   default="S09_underground_garage"/>

  <arg name="map_dir" default="$(env HOME)/whut_thesis/exp/maps/$(arg scene)"/>
  <arg name="config"  default="$(find fwis_planner_hybrid_astar)/config/params.yaml"/>
  <arg name="rvizcfg" default="$(find fwis_planner_hybrid_astar)/rviz/single_vehicle.rviz"/>
  <arg name="scenarios_dir" default="$(env HOME)/whut_thesis/exp/scenarios"/>

  <!-- ============================== -->
  <!-- Map publisher                  -->
  <!-- ============================== -->
  <node name="fwis_map_publisher"
        pkg="fwis_map_server"
        type="map_publisher.py"
        output="screen">
    <param name="map_dir" value="$(arg map_dir)"/>
  </node>

  <!-- ============================== -->
  <!-- Hybrid A* planner              -->
  <!-- ============================== -->
  <node name="fwis_planner"
        pkg="fwis_planner_hybrid_astar"
        type="fwis_planner_hybrid_astar_node"
        output="screen">
    <rosparam command="load" file="$(arg config)"/>
    <rosparam command="load" file="$(find fwis_common)/config/ranger_mini_2.yaml"/>
  </node>

  <!-- ============================== -->
  <!-- Velocity-profile QP backend (K01 §6) -->
  <!-- ============================== -->
  <include file="$(find fwis_backend_qp)/launch/safe_corridor_backend.launch"/>

  <!-- ============================== -->
  <!-- Vehicle visualizer / playback  -->
  <!-- ============================== -->
  <node name="fwis_playback"
        pkg="fwis_planner_hybrid_astar"
        type="playback.py"
        output="screen">
    <rosparam command="load" file="$(arg config)"/>
    <rosparam command="load" file="$(find fwis_common)/config/ranger_mini_2.yaml"/>
  </node>

  <!-- ============================== -->
  <!-- Scene hint markers + preset goal launcher -->
  <!-- ============================== -->
  <node name="fwis_scene_hints"
        pkg="fwis_map_server"
        type="scene_hints.py"
        output="screen">
    <param name="scene" value="$(arg scene)"/>
  </node>

  <!-- ============================== -->
  <!-- Painted parking-slot outlines  -->
  <!-- ============================== -->
  <node name="fwis_parking_lines"
        pkg="fwis_map_server"
        type="parking_lines.py"
        output="screen">
    <param name="scene"          value="$(arg scene)"/>
    <param name="scenarios_dir"  value="$(arg scenarios_dir)"/>
  </node>

  <!-- ============================== -->
  <!-- RViz                           -->
  <!-- ============================== -->
  <node name="rviz"
        pkg="rviz"
        type="rviz"
        args="-d $(arg rvizcfg)"
        required="true"/>
</launch>
