     # -- dynamics ------------------------------------------------------
+    def _dynamic_derivative_bound(self, name, edge, vehicle_id, factors,
+                                  bounds):
+        """Same-phase conservative bound for d(quantity)/dt, if available.
+
+        ``_dynamic_bounds`` already returns an analytic full-interval
+        supremum for the quantity itself.  The derivative bound lets the
+        candidate-grid peak be corrected for the maximum distance between a
+        query time and its nearest candidate::
+
+            sup ||q|| <= max_grid ||q|| + sup ||q_dot|| * h / 2
+
+        with ``h`` the largest adjacent physical time gap.  This is the
+        jerk-error bound used for acceleration; the other entries are the
+        same construction where the existing analytic quantities provide a
+        valid derivative bound.  No second time model is introduced.
+        """
+        if name == "speed":
+            return "acceleration", bounds["acceleration"]
+        if name == "acceleration":
+            return "jerk", bounds["jerk"]
+        if name == "yaw_rate":
+            return "yaw_acceleration", bounds["yaw_acceleration"]
+        if name == "yaw_acceleration":
+            return "yaw_jerk", bounds["yaw_jerk"]
+        if name == "wheel_speed":
+            if edge.mode == MODE_S:
+                return ("yaw_acceleration",
+                        max(factors) * bounds["yaw_acceleration"])
+            return "acceleration", max(factors) * bounds["acceleration"]
+        if name == "lateral_acceleration":
+            if edge.mode != MODE_A:
+                return "acceleration", 0.0
+            control = abs(self._edge_control_value(edge, vehicle_id))
+            return ("acceleration",
+                    2.0 * control * bounds["speed"] * bounds["acceleration"])
+        # No same-phase derivative bound (snap) is available for jerk, so
+        # jerk uses the analytic supremum only.
+        return None, None
+
