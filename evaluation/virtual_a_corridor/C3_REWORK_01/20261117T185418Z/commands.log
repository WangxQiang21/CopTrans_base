  > "$EV/test_logs/test_virtual_a_corridor_optimizer.log" 2>&1
# EXIT=0 (Ran 24 tests, OK)

# start 2026-11-17T18:56:25Z | end 2026-11-17T18:57:30Z | exit 0 | wall 64.500 s
timeout 900 python3 -B -m unittest discover -s tests \
  -p 'test_virtual_a_optimizer.py' -v \
  > "$EV/test_logs/test_virtual_a_optimizer.log" 2>&1
# EXIT=0 (Ran 29 tests, OK)

# start 2026-11-17T18:57:30Z | end 2026-11-17T18:59:15Z | exit 0 | wall 104.628 s
timeout 900 python3 -B -m unittest discover -s tests \
